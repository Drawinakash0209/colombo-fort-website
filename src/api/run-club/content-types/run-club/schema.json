{
  "kind": "singleType",
  "collectionName": "run_clubs",
  "info": {
    "singularName": "run-club",
    "pluralName": "run-clubs",
    "displayName": "Run Club",
    "description": "Content for the Run Club page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "missionText": {
      "type": "text"
    },
    "whatWeDo": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-card"
    },
    "values": {
      "type": "component",
      "repeatable": true,
      "component": "shared.value-item"
    },
    "whyJoinIntro": {
      "type": "string",
      "default": "Members enjoy:"
    },
    "memberBenefits": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item"
    },
    "whoCanJoinIntro": {
      "type": "text"
    },
    "whoCanJoin": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item"
    },
    "whoCanJoinNote": {
      "type": "text"
    },
    "joinTitle": {
      "type": "string",
      "default": "Join the Movement"
    },
    "joinText": {
      "type": "text"
    }
  }
}
