{
  "kind": "singleType",
  "collectionName": "fort_views",
  "info": {
    "singularName": "fort-view",
    "pluralName": "fort-views",
    "displayName": "Fort View",
    "description": "Content for the Fort View (photography service) page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "missionText": {
      "type": "text"
    },
    "whatWeDo": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-card"
    },
    "values": {
      "type": "component",
      "repeatable": true,
      "component": "shared.value-item"
    },
    "whyJoinIntro": {
      "type": "string",
      "default": "Members get the opportunity to:"
    },
    "memberBenefits": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item"
    },
    "whoCanJoinIntro": {
      "type": "text"
    },
    "whoCanJoin": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item"
    },
    "whoCanJoinNote": {
      "type": "text"
    },
    "workWithUsTitle": {
      "type": "string",
      "default": "Have a Story Worth Capturing?"
    },
    "workWithUsText": {
      "type": "text"
    }
  }
}
