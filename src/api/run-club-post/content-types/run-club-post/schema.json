      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "postedAt": {
      "type": "datetime"
    }
  }
}
