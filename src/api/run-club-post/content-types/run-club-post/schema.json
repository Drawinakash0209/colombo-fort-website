    "singularName": "run-club-post",
    "pluralName": "run-club-posts",
    "displayName": "Run Club Post",
    "description": "Posts/updates shown on the Run Club page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
