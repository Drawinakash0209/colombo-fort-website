{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "date": {
      "type": "date"
    },
    "description": {
      "type": "blocks"
    },
    "avenues": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::avenue.avenue",
      "inversedBy": "projects"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "projectStatus": {
      "type": "enumeration",
      "enum": [
        "Completed",
        "Ongoing",
        "Upcoming"
      ]
    },
    "metaDescription": {
      "type": "string"
    },
    "featured": {
      "type": "boolean"
    },
    "focusLocation": {
      "type": "string"
    },
    "impactGroup": {
      "type": "string"
    },
    "chairDirectors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::director.director",
      "inversedBy": "projectsChaired"
    },
    "chairExco": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::exco.exco",
      "inversedBy": "projectsChaired"
    },
    "chairMembers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::member.member",
      "inversedBy": "projectsChaired"
    }
  }
}
