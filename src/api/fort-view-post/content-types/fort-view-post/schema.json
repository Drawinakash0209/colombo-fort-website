{
  "kind": "collectionType",
  "collectionName": "fort_view_posts",
  "info": {
    "singularName": "fort-view-post",
    "pluralName": "fort-view-posts",
    "displayName": "Fort View Post",
    "description": "Posts/updates shown on the Fort View page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "subline": {
      "type": "string"
    },
    "authorName": {
      "type": "string",
      "default": "Rotaract Club of Colombo Fort"
    },
    "likes": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.tag"
    },
    "description": {
      "type": "blocks"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "postedAt": {
      "type": "datetime"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "fortViewPost"
    }
  }
}
